{
  "name": "@jimiagent/tui",
  "version": "0.1.0",
  "description": "JimiAgent React/Ink terminal UI",
  "private": true,
  "type": "module",
  "bin": {
    "jimi-tui": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20",
    "yarn": "^1.22"
  },
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node dist/cli.js\"",
    "build": "tsup",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts,tsx",
    "clean": "rimraf dist",
    "smoke": "node scripts/smoke-transport.mjs"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "chalk": "^5.3.0",
    "react": "^18.3.1",
    "zustand": "^4.5.4",
    "immer": "^10.1.1",
    "fuse.js": "^7.0.0",
    "diff": "^5.2.0",
    "clipboardy": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/diff": "^5.2.1",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "ink-testing-library": "^4.0.0",
    "rimraf": "^5.0.9",
    "tsup": "^8.1.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4"
  }
}
